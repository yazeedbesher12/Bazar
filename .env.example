# Compose service DNS names; these defaults require no credentials.
CATALOG_URL=http://catalog:5001
ORDER_URL=http://order:5002

# Container path: keep it under /data to use Catalog's persistent volume.
CATALOG_DB_PATH=/data/catalog.sqlite3
ORDER_DB_PATH=/data/order.sqlite3

# Host client only; not an extra Compose service.
FRONTEND_URL=http://localhost:5000
